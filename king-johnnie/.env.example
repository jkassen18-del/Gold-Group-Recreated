# ---------------------------------------------------------------------------
# King Johnnie — environment configuration
# Copy this file to `.env` and fill in the values for your backend.
#
# Expo reads EXPO_PUBLIC_* variables at build time and exposes them on
# process.env.* inside the app. See src/services/config.ts.
# ---------------------------------------------------------------------------

# Which data source the app talks to.
#   mock  -> fully offline, uses bundled demo data (default, great for design review)
#   live  -> hits the REST endpoints below
EXPO_PUBLIC_DATA_SOURCE=mock

# Base URL of the casino platform / aggregator REST API (no trailing slash).
EXPO_PUBLIC_API_BASE_URL=https://api.kingjohnnie.ai

# Optional per-domain overrides (fall back to API_BASE_URL when empty).
EXPO_PUBLIC_AUTH_BASE_URL=
EXPO_PUBLIC_WALLET_BASE_URL=
EXPO_PUBLIC_GAMES_BASE_URL=

# Game launch / aggregator (e.g. SoftSwiss, Pragmatic Play, EveryMatrix).
EXPO_PUBLIC_GAME_LAUNCH_URL=

# Live chat / support widget (Intercom, LiveChat, Zendesk, ...).
EXPO_PUBLIC_SUPPORT_CHAT_URL=

# Analytics (optional).
EXPO_PUBLIC_ANALYTICS_KEY=

# Default market.
EXPO_PUBLIC_DEFAULT_CURRENCY=AUD
EXPO_PUBLIC_DEFAULT_LOCALE=en
